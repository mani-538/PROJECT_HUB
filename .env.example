# Project Hub Environment Configuration Example
# Copy this file to .env for local development

# Flask Application Secret Key (Required)
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Flask Environment & Debug
FLASK_APP=app.py
FLASK_DEBUG=false
PORT=5000

# Database Configuration
# Local SQLite default: sqlite:///project_hub.db
# Cloud PostgreSQL (Supabase):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Persistent Cloud Object Storage (Supabase Storage)
# Required on ephemeral hosts like Render to persist uploads across redeploys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=projecthub-uploads

# Public Demo Safety
# Disables destructive admin actions (such as account deletion) in public trial mode
DISABLE_DESTRUCTIVE_ADMIN=true
